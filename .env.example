# Copy this file to .env and fill in the values you need.

# --- Local development: call Gemini directly ---
# Get a key at https://aistudio.google.com/app/apikey
# In local dev the key is bundled into the browser build (fine for dev).
VITE_GEMINI_API_KEY=

# --- Production: call Gemini through the Supabase Edge Function proxy ---
# When this is set, the app posts chat requests to the Edge Function instead of
# calling Gemini directly, so the API key is NEVER in the public bundle. Set the
# key as the function's GEMINI_API_KEY secret (Supabase dashboard → Edge
# Functions → gemini → Secrets, or `supabase secrets set GEMINI_API_KEY=...`).
# Leave VITE_GEMINI_API_KEY empty in production.
VITE_GEMINI_PROXY_URL=

# --- Supabase (optional, for future cloud sync of profile/reports/reminders) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
